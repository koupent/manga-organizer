{
  "$schema": "https://raw.githubusercontent.com/koupent/engineering-dev-foundation/main/schema/config.schema.json",
  "version": 2,
  "capabilities": {
    "agents": {
      "claude": true,
      "codex": true,
      "claudeVersion": "latest",
      "codexVersion": "latest"
    },
    "shell": {
      "type": "zsh"
    },
    "voice": {
      "enabled": true,
      "mode": "auto",
      "port": 24713
    },
    "storage": {
      "authentication": true,
      "worktrees": true,
      "vhdxProtection": true
    },
    "security": {
      "sandbox": true,
      "privileged": false
    },
    "logging": {
      "maxSize": "10m",
      "maxFiles": 3
    }
  }
}
