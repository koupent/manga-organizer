{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manga Organizer",
  "version": "4.0.0",
  "identifier": "dev.koupent.manga-organizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && bash ../../scripts/build_sidecar.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Manga Organizer",
        "width": 1280,
        "height": 860,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/sidecar/**/*"],
    "windows": {
      "nsis": {
        "languages": ["Japanese"]
      }
    },
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
