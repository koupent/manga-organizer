  "components": {
    "schemas": {
      "BrowseEntry": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "is_directory": {
            "type": "boolean",
            "title": "Is Directory"
          }
        },
        "type": "object",
        "required": [
          "name",
          "path",
          "is_directory"
        ],
        "title": "BrowseEntry",
        "description": "ファイル選択に出す 1 項目"
      },
      "BrowseResult": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/BrowseEntry"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "path",
          "entries"
        ],
        "title": "BrowseResult",
        "description": "辿っている場所と、その中身"
      },
      "CoverRequest": {
        "properties": {
          "archive": {
            "type": "string",
            "title": "Archive",
            "description": "対象アーカイブの絶対パス"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "加工するページ名（通常は先頭）"
          },
          "split": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Split",
            "description": "見開きの残す側（left / right）"
          },
          "crop": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
