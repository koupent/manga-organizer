{
  "name": "manga-organizer",
  "build": {
    "dockerfile": "Dockerfile.project",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/manga-organizer",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "git.detectWorktrees": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "python.defaultInterpreterPath": "${workspaceFolder}/manga-organizer/.venv/bin/python"
      }
    }
  },
  "postCreateCommand": "bash -lc 'cd manga-organizer && uv sync --group dev'"
}
