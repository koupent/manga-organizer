    "/api/resolve": {
      "post": {
        "summary": "Resolve",
        "description": "ドロップされたファイルを実パスに結びつける。\n\nブラウザは実パスを渡さないが、名前とサイズは分かる。許可された場所の\n中から同じものを探せば、ドロップからでも対象を特定できる。同名が複数\nあってサイズでも絞れない場合は、勝手に選ばず返す。",
        "operationId": "resolve_api_resolve_post",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
