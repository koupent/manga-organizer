{
  "name": "Claude Code with Playwright and noVNC",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Asia/Tokyo}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "lang2hong.githd",
        "bierner.markdown-mermaid",
        "shd101wyy.markdown-preview-enhanced",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter"
      ],
      "settings": {
        // フォーマッター設定
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "notebook.defaultFormatter": "ms-python.black-formatter",
        "notebook.formatOnSave.enabled": true,
        "notebook.formatOnCellExecution": true,

        // エディター設定
        "files.autoSave": "onFocusChange",
        "editor.unicodeHighlight.invisibleCharacters": false,
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "diffEditor.hideUnchangedRegions.enabled": true,
        "typescript.updateImportsOnFileMove.enabled": "always",

        // ターミナル設定
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        },

        // Python設定
        "python.defaultInterpreterPath": "/home/node/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.analysis.autoImportCompletions": true,
        "python.formatting.provider": "black",
        "python.formatting.blackArgs": ["--line-length=88"],

        // Git設定
        "git.autofetch": true,

        // リモート・セキュリティ設定
        "remote.autoForwardPortsSource": "hybrid",

        // Markdown設定
        "markdown-preview-enhanced.previewTheme": "atom-dark.css",
        "extensions.ignoreRecommendations": true
      }
    }
  },
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=claude-code-gh-config-${devcontainerId},target=/home/node/.config/gh,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "PLAYWRIGHT_MCP_HEADLESS": "false",
    "PLAYWRIGHT_MCP_SANDBOX": "false",
    "DISPLAY": ":0"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "forwardPorts": [6080, 5900],
  "portsAttributes": {
    "6080": {
      "label": "noVNC access",
      "onAutoForward": "notify"
    },
    "5900": {
      "label": "VNC (raw)"
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/setup-superclaude.sh",
  "postStartCommand": "bash .devcontainer/scripts/start-vnc.sh"
}
