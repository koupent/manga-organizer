{
  "version": 2,
  "provider": "github",
  "ruleset": {
    "name": "Engineering Local Delivery",
    "target": "default-branch",
    "enforcement": "active",
    "enforceAdministrators": true,
    "requirePullRequest": true,
    "requiredApprovals": 0,
    "allowedMergeMethods": [
      "squash"
    ],
    "requiredStatusCheck": "Local Merge Gate",
    "strictStatusCheck": true,
    "linearHistory": true,
    "blockForcePushes": true,
    "blockDeletions": true
  },
  "actions": {
    "allowedTriggers": [
      "workflow_dispatch"
    ],
    "requiredInputs": [
      "artifact_ref",
      "artifact_sha256",
      "source_commit",
      "source_tree"
    ]
  }
}
